<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "https://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="Chat">
    <resultMap id="chat_clob" type="java.lang.String">
        <result property="chatroom_user_list" column="chatroom_user_list" javaType="java.lang.String"/>
    </resultMap>
    <insert id="insertChatRoom">
        insert into chatroom values(chatroom_seq.nextval, #{chatroom_id}, #{chatroom_title}, #{chatroom_user_list}, sysdate, #{chatroom_desc})
    </insert>
    <select id="selectNextval" resultType="int">
        select chatroom_seq.nextval from dual
    </select>
    <select id="selectChatByUserSeq" resultType="com.kedu.game.DTO.ChatRoomDTO">
        select chatroom_title, chatroom_id from CHATROOM where chatroom_user_list like '[%'||#{user_seq}||'%]'
    </select>
</mapper>
